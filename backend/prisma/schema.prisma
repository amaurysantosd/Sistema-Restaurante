// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  GERENTE
  GARCOM
  CAIXA
  COZINHA
  BAR
}

model Empresa {
  id           String   @id @default(uuid())
  nomeFantasia String
  cnpj         String   @unique
  telefone     String
  email        String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  filiais    Filial[]
  usuarios   Usuario[]
  categorias Categoria[]

  tipoAmbientes TipoAmbiente[]

  alergenos Alergeno[]

  ingredientes Ingrediente[]

  tags Tag[]

  tiposChamado TipoChamado[]

  // Config de recebimento de reservas (Fase 6). PIX_MANUAL por default --
  // GATEWAY existe so como opcao futura, depende do modulo Financeiro (Fase 9).
  modalidadePagamentoReserva ModalidadePagamentoReserva @default(PIX_MANUAL)
  contasRecebimento          ContaRecebimento[]
}

model Filial {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  telefone  String?
  endereco  String?
  ativo     Boolean  @default(true)
  matriz    Boolean  @default(false) // Marca se esta Filial e a sede/matriz da empresa
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Se o garcom da area consegue ver o que o cliente marcou como consumido
  // (ConsumoCliente) -- feature informal do cliente, exibicao pro staff e opcional
  exibirConsumoClienteParaGarcom Boolean @default(false)

  // PROVISORIO (Fase 6) -- migrar para painel administrativo de configuracao
  // quando esse painel existir, mesmo espirito das constantes de Presenca.
  reservaExigeCadastro         Boolean @default(false)
  reservaPercentualSinalPadrao Float   @default(50)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarios Usuario[]
  ambientes Ambiente[]

  @@index([empresaId])

  produtos Produto[]
  combos Combo[]

  clienteFiliais ClienteFilial[]
  historicoVisitas HistoricoVisita[]

  eventos Evento[]
  reservas Reserva[]
  listaEspera ListaEspera[]
}

model Ambiente {
  id          String       @id @default(uuid())
  nome        String
  descricao   String?
  tipoAmbienteId String
  tipoAmbiente   TipoAmbiente @relation(fields: [tipoAmbienteId], references: [id])
  andar       Int?
  capacidade  Int?
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  /* cria um índice na coluna filialId, o que acelera consultas do tipo "todos os ambientes desta 
  filial */
  @@index([filialId])

  // Lado inverso da relacao: um Ambiente pode ter varias Mesas
  mesas Mesa[]

  eventos Evento[]
  reservas Reserva[]
}

model Mesa {
  id         String   @id @default(uuid())
  numero     String
  capacidade Int?
  qrCode     String   @unique
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /* Relacionamento cria uma coluna 'ambienteId', ]
  Ela guarda o ID do ambiente ao qual a mesa pertence. */
  ambienteId String
  /* Relação - Essa linha diz ao Prisma: "O campo ambienteId referencia o id da 
  tabela Ambiente." */
  ambiente   Ambiente @relation(fields: [ambienteId], references: [id])

  // Cria um índice para a coluna ambienteId
  @@index([ambienteId])
  historicoVisitas HistoricoVisita[]

  comandas Comanda[]
  chamados Chamado[]
  consumosCliente ConsumoCliente[]
  sessoesPresenca SessaoPresenca[]
  reservas Reserva[]
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  superAdmin Boolean @default(false)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  filialId String?
  filial   Filial? @relation(fields: [filialId], references: [id])

  @@index([empresaId])
  @@index([filialId])

  comandasAbertas Comanda[]
  itensComandaCriados ItemComanda[]
  chamadosAtendidos Chamado[]
  reservasCriadas Reserva[]
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  // Destino padrao (Cozinha/Bar) dos produtos desta categoria -- Produto.destino
  // pode sobrescrever pontualmente. Default COZINHA e so um valor de partida para
  // categorias ja existentes; revisar manualmente apos a migration.
  destinoPadrao DestinoPreparo @default(COZINHA)

  @@unique([empresaId, nome])
  @@index([empresaId])
  produtos Produto[]
}

model TipoAmbiente {
  id        String   @id @default(uuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  ambientes Ambiente[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Produto {
  id                String    @id @default(uuid())
  nome              String
  slug              String
  descricao         String?
  descricaoCurta    String?
  tempoPreparo      Int?      // em minutos
  ativo             Boolean   @default(true)
  destaque          Boolean   @default(false)
  ordemExibicao     Int       @default(0)
  visualizacoes     Int       @default(0)
  vendas            Int       @default(0)

  // Especifico para bebidas (opcional -- nao se aplica a comida)
  ehAlcoolico     Boolean @default(false)
  teorAlcoolico   Float?  // percentual de teor alcoolico
  ibu             Int?    // amargor, especifico de cervejas

  // Opcional -- se null, usa o destinoPadrao da Categoria. Preenchido so quando
  // este produto especifico foge da regra padrao da propria categoria.
  destino DestinoPreparo?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft delete: nulo = ativo, preenchido = "removido"

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  categoriaId String
  categoria   Categoria @relation(fields: [categoriaId], references: [id])

  @@unique([filialId, slug])
  @@index([filialId])
  @@index([categoriaId])

  produtoMidias ProdutoMidia[]
  produtoIngredientes ProdutoIngrediente[]
  produtoAlergenos ProdutoAlergeno[]

  harmonizacaos Harmonizacao[] @relation("ProdutoPrincipal")
  harmonizacaosEm Harmonizacao[] @relation("ProdutoHarmonizado")
  produtoTags ProdutoTag[]
  produtoVariacaoPrecos ProdutoVariacaoPreco[]
  produtoDisponibilidades ProdutoDisponibilidade[]
  comboItems ComboItem[]
  promocaos Promocao[]
  favoritos Favorito[]
  consumosCliente ConsumoCliente[]
}

enum TipoMidia {
  FOTO
  VIDEO
}

model ProdutoMidia {
  id        String    @id @default(uuid())
  tipo      TipoMidia
  url       String
  thumbnail String?   // miniatura, especialmente util para videos
  ordem     Int       @default(0)
  principal Boolean   @default(false) // marca qual midia aparece primeiro/capa

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
}

model Ingrediente {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtos ProdutoIngrediente[] // lado inverso da relacao N:N com Produto

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Alergeno {
  id    String  @id @default(uuid())
  nome  String  // ex: "Gluten", "Lactose", "Amendoim", "Frutos do mar"
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtos ProdutoAlergeno[] // lado inverso da relacao N:N com Produto

  @@unique([empresaId, nome])
  @@index([empresaId])
  
}

model ProdutoIngrediente {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  ingredienteId String
  ingrediente   Ingrediente @relation(fields: [ingredienteId], references: [id])

  @@unique([produtoId, ingredienteId]) // evita duplicar o mesmo ingrediente no mesmo produto
}

model ProdutoAlergeno {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  alergenoId String
  alergeno   Alergeno @relation(fields: [alergenoId], references: [id])

  @@unique([produtoId, alergenoId])
}

model Harmonizacao {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation("ProdutoPrincipal", fields: [produtoId], references: [id])

  produtoHarmonizadoId String
  produtoHarmonizado   Produto @relation("ProdutoHarmonizado", fields: [produtoHarmonizadoId], references: [id])

  createdAt DateTime @default(now())

  @@unique([produtoId, produtoHarmonizadoId])
}

model Tag {
  id    String  @id @default(uuid())
  nome  String  // ex: "Familia", "Individual", "+18", "Vegano", "Mais vendido"
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  produtos ProdutoTag[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model ProdutoTag {
  id String @id @default(uuid())

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  tagId String
  tag   Tag @relation(fields: [tagId], references: [id])

  @@unique([produtoId, tagId])
}

model ProdutoVariacaoPreco {
  id        String  @id @default(uuid())
  nome      String  // ex: "Preco 1", "Dose", "Garrafa", "Vodka Smirnoff"
  descricao String? // ex: "Vodka mais barata, frutas e energetico mais em conta"
  preco     Float
  principal Boolean @default(false) // qual variacao aparece como preco de destaque no cardapio
  ordem     Int     @default(0)
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
  promocaos Promocao[]
  itensComanda ItemComanda[]
}

model ProdutoDisponibilidade {
  id String @id @default(uuid())

  // Cada linha e UMA REGRA de disponibilidade. Um produto pode ter varias
  // regras, permitindo combinacoes como:
  //   Regra 1: segunda-sexta, das 18h as 23h
  //   Regra 2: sabado-domingo, das 12h as 23h
  // O produto fica disponivel se QUALQUER regra bater com o dia/hora atual.

  domingo Boolean @default(false)
  segunda Boolean @default(false)
  terca   Boolean @default(false)
  quarta  Boolean @default(false)
  quinta  Boolean @default(false)
  sexta   Boolean @default(false)
  sabado  Boolean @default(false)

  horaInicio String // ex: "18:00"
  horaFim    String // ex: "23:00"

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  produtoId String  // SEM @unique agora -- um produto pode ter varias regras
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@index([produtoId])
}

enum TipoDesconto {
  PERCENTUAL
  VALOR_FIXO
}

model Promocao {
  id          String       @id @default(uuid())
  nome        String       // ex: "Happy Hour", "Black Friday do Chopp"
  descricao   String?
  tipoDesconto TipoDesconto
  valorDesconto Float       // ex: 20 (=20% se PERCENTUAL, ou R$20 se VALOR_FIXO)

  // Promocao = "o PRECO muda num periodo", sem afetar se o produto esta
  // disponivel (isso e responsabilidade de ProdutoDisponibilidade acima).
  // Duas formas de vigencia, mutuamente exclusivas na pratica:

  // 1) Periodo absoluto (ex: Black Friday de 25/11 a 27/11) -- usar quando
  //    NAO for recorrente.
  dataInicio DateTime?
  dataFim    DateTime?

  // 2) Recorrente (ex: Happy Hour toda sexta e sabado, das 18h as 20h) --
  //    quando recorrente=true, o sistema ignora dataInicio/dataFim e passa
  //    a considerar os dias da semana + horario abaixo, repetindo toda semana.
  recorrente Boolean @default(false)
  domingo    Boolean @default(false)
  segunda    Boolean @default(false)
  terca      Boolean @default(false)
  quarta     Boolean @default(false)
  quinta     Boolean @default(false)
  sexta      Boolean @default(false)
  sabado     Boolean @default(false)
  horaInicio String?
  horaFim    String?

  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

   produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  // Opcional: se preenchido, a promocao vale so para esta variacao especifica
  // (ex: so no "Litrao"). Se null, vale para TODAS as variacoes do produto.
  produtoVariacaoPrecoId String?
  produtoVariacaoPreco   ProdutoVariacaoPreco? @relation(fields: [produtoVariacaoPrecoId], references: [id])

  @@index([produtoId])
  @@index([produtoVariacaoPrecoId])
}

model Combo {
  id        String  @id @default(uuid())
  nome      String  // ex: "Combo Whisky + Red Bull"
  descricao String?
  preco     Float   // preco do pacote inteiro, independente da soma dos itens
  ativo     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  itens ComboItem[]

  @@index([filialId])

  itensComanda ItemComanda[]
}

model ComboItem {
  id         String @id @default(uuid())
  quantidade Int    @default(1)

  comboId String
  combo   Combo @relation(fields: [comboId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@unique([comboId, produtoId]) // um produto so pode aparecer uma vez por combo
  @@index([comboId])
  @@index([produtoId])
}

model Cliente {
  id              String  @id @default(uuid())
  nome            String
  telefone        String  @unique
  email           String? @unique
  cpf             String? @unique
  googleId        String? @unique
  fotoUrl         String?
  ativo           Boolean @default(true)
  aceitaMarketing Boolean @default(false) // consentimento separado (LGPD) para uso em marketing

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteFiliais   ClienteFilial[]
  favoritos        Favorito[]
  historicoVisitas HistoricoVisita[]
  restricoes       ClienteRestricao[]
  consumos         ConsumoCliente[]
  sessoesPresenca  SessaoPresenca[]
  reservas         Reserva[]
  listaEspera      ListaEspera[]
}

model ClienteFilial {
  id String @id @default(uuid())

  pontosFidelidade Int      @default(0)
  saldoCashback    Float    @default(0)
  primeiraVisita   DateTime @default(now())
  ativo            Boolean  @default(true)

  // Marcado manualmente pelo staff, independente da contagem automatica de
  // visitas/pontos -- cobre casos que numero nenhum capturaria (amigo do
  // dono, influenciador, etc.)
  vipManual Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  @@unique([clienteId, filialId])
  @@index([clienteId])
  @@index([filialId])
}

model Favorito {
  id String @id @default(uuid())

  createdAt DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  @@unique([clienteId, produtoId]) // evita favoritar o mesmo produto duas vezes
  @@index([clienteId])
  @@index([produtoId])
}

model HistoricoVisita {
  id String @id @default(uuid())

  dataVisita DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  // Opcional: em qual mesa, se aplicavel (pode ser null se for so um
  // registro de "visitou a filial", sem vincular a uma mesa especifica)
  mesaId String?
  mesa   Mesa?   @relation(fields: [mesaId], references: [id])

  @@index([clienteId])
  @@index([filialId])
}

model ClienteRestricao {
  id String @id @default(uuid())

  createdAt DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  restricaoId String
  restricao   RestricaoAlimentar @relation(fields: [restricaoId], references: [id])

  @@unique([clienteId, restricaoId])
  @@index([clienteId])
  @@index([restricaoId])
  
}

model RestricaoAlimentar {
  id    String  @id @default(uuid())
  nome  String  @unique // ex: "Sem Gluten", "Sem Lactose", "Vegetariano", "Vegano", "Sem Amendoim"
  ativo Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientes ClienteRestricao[]
}

// ==========================================================================
// Fase 4 -- Atendimento (Comandas, Chamados de Mesa, Consumo do Cliente)
// ==========================================================================

enum DestinoPreparo {
  COZINHA
  BAR
}

enum StatusChamado {
  PENDENTE
  EM_ATENDIMENTO
  ATENDIDO
}

enum StatusComanda {
  ABERTA
  FECHADA
  CANCELADA
}

enum StatusItemComanda {
  PENDENTE
  EM_PREPARO
  PRONTO
  ENTREGUE
  CANCELADO
}

model TipoChamado {
  id    String  @id @default(uuid())
  nome  String
  ativo Boolean @default(true)

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  chamados Chamado[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model Chamado {
  id         String        @id @default(uuid())
  status     StatusChamado @default(PENDENTE)
  criadoEm   DateTime      @default(now())
  atendidoEm DateTime?

  tipoChamadoId String
  tipoChamado   TipoChamado @relation(fields: [tipoChamadoId], references: [id])

  mesaId String
  mesa   Mesa @relation(fields: [mesaId], references: [id])

  atendidoPorUsuarioId String?
  atendidoPorUsuario   Usuario? @relation(fields: [atendidoPorUsuarioId], references: [id])

  @@index([mesaId])
}

model Comanda {
  id     String        @id @default(uuid())
  nome   String        @default("Principal")
  status StatusComanda @default(ABERTA)

  abertaEm  DateTime  @default(now())
  fechadaEm DateTime?

  mesaId String
  mesa   Mesa @relation(fields: [mesaId], references: [id])

  abertaPorUsuarioId String
  abertaPorUsuario   Usuario @relation(fields: [abertaPorUsuarioId], references: [id])

  itens ItemComanda[]

  @@index([mesaId])
}

model ItemComanda {
  id            String            @id @default(uuid())
  quantidade    Int               @default(1)
  precoUnitario Float             // CONGELADO no momento da criacao -- nunca muda depois
  status        StatusItemComanda @default(PENDENTE)
  destino       DestinoPreparo    // copiado do Produto/Categoria no momento da criacao

  criadoEm   DateTime  @default(now())
  prontoEm   DateTime?
  entregueEm DateTime?

  comandaId String
  comanda   Comanda @relation(fields: [comandaId], references: [id])

  // EXATAMENTE UM dos dois deve estar preenchido (Produto OU Combo, nunca os dois
  // nem nenhum). Validar no Service -- o banco nao forca isso sozinho.
  produtoVariacaoPrecoId String?
  produtoVariacaoPreco   ProdutoVariacaoPreco? @relation(fields: [produtoVariacaoPrecoId], references: [id])

  comboId String?
  combo   Combo?  @relation(fields: [comboId], references: [id])

  criadoPorUsuarioId String
  criadoPorUsuario   Usuario @relation(fields: [criadoPorUsuarioId], references: [id])

  @@index([comandaId])
}

model ConsumoCliente {
  id         String   @id @default(uuid())
  quantidade Int      @default(1)
  marcadoEm  DateTime @default(now())

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  produtoId String
  produto   Produto @relation(fields: [produtoId], references: [id])

  mesaId String
  mesa   Mesa @relation(fields: [mesaId], references: [id])

  @@index([clienteId])
  @@index([mesaId])
}

// ==========================================================================
// Fase 5 -- Presenca Inteligente (check-in automatico via QR Code)
// ==========================================================================

enum StatusSessao {
  ATIVA
  ENCERRADA
}

model SessaoPresenca {
  id     String       @id @default(uuid())
  status StatusSessao @default(ATIVA)

  checkInEm         DateTime  @default(now())
  ultimaAtividadeEm DateTime  @default(now()) // atualizado a cada acao relevante do cliente
  encerradaEm       DateTime?

  clienteId String
  cliente   Cliente @relation(fields: [clienteId], references: [id])

  mesaId String
  mesa   Mesa @relation(fields: [mesaId], references: [id])

  @@index([clienteId])
  @@index([mesaId])
  @@index([status])
}

// ==========================================================================
// Fase 6 -- Reservas e Eventos
// ==========================================================================

enum TipoEvento {
  PARTICULAR // aniversario/confraternizacao que bloqueia ambiente/filial inteiro
  SAZONAL    // data comemorativa (natal, virada de ano, dia dos namorados)
}

enum StatusReserva {
  PENDENTE
  CONFIRMADA
  CANCELADA
  COMPARECEU
  NAO_COMPARECEU // no-show, marcado automaticamente pelo job
}

enum StatusListaEspera {
  AGUARDANDO
  CHAMADO  // staff avisou que a mesa esta pronta
  ATENDIDO // cliente foi acomodado
  DESISTIU
}

enum ModalidadePagamentoReserva {
  PIX_MANUAL // exibe dados da ContaRecebimento, staff confirma manualmente
  GATEWAY    // integracao automatica -- NAO IMPLEMENTAR AGORA, depende da Fase 9
}

enum FinalidadeRecebimento {
  COMANDA
  RESERVA
  EVENTO
  GERAL
}

model Evento {
  id        String     @id @default(uuid())
  nome      String
  tipo      TipoEvento
  descricao String?

  dataInicio DateTime
  dataFim    DateTime

  // Se preenchido, bloqueia a filial inteira nesse periodo. Se null mas
  // ambienteId preenchido, bloqueia so aquele ambiente. Os dois nulos = evento
  // "informativo", sem bloqueio automatico de reservas.
  filialId String?
  filial   Filial? @relation(fields: [filialId], references: [id])

  ambienteId String?
  ambiente   Ambiente? @relation(fields: [ambienteId], references: [id])

  valorEntrada Float? // cobranca de entrada, se houver (ligacao futura com Financeiro)
  ativo        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reservas Reserva[]

  @@index([filialId])
  @@index([ambienteId])
}

model Reserva {
  id                String        @id @default(uuid())
  dataHora          DateTime
  quantidadePessoas Int
  status            StatusReserva @default(PENDENTE)
  observacoes       String?

  // Preenchido pelo staff quando a reserva e feita sem Cliente cadastrado
  // (ex: reserva por telefone). Se clienteId existir, usar os dados do Cliente.
  nomeConvidado     String?
  telefoneConvidado String?

  // Orcamento opcional -- so gera cobranca de sinal se preenchido E se a
  // configuracao do estabelecimento previr cobranca para este caso
  valorOrcamento  Float?
  percentualSinal Float? // copiado da config no momento da criacao (congelado)
  valorSinal      Float? // calculado: valorOrcamento * (percentualSinal / 100)
  sinalPago       Boolean @default(false)

  // Tolerancia de comparecimento, usada pelo job de no-show
  toleranciaAte DateTime?

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  ambienteId String?
  ambiente   Ambiente? @relation(fields: [ambienteId], references: [id])

  mesaId String?
  mesa   Mesa? @relation(fields: [mesaId], references: [id])

  eventoId String?
  evento   Evento? @relation(fields: [eventoId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  criadoPorUsuarioId String?
  criadoPorUsuario   Usuario? @relation(fields: [criadoPorUsuarioId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([filialId])
  @@index([clienteId])
  @@index([eventoId])
  @@index([dataHora])
}

model ListaEspera {
  id                String            @id @default(uuid())
  quantidadePessoas Int
  status            StatusListaEspera @default(AGUARDANDO)

  nomeConvidado     String?
  telefoneConvidado String?

  criadoEm   DateTime  @default(now())
  chamadoEm  DateTime?
  atendidoEm DateTime?

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  clienteId String?
  cliente   Cliente? @relation(fields: [clienteId], references: [id])

  @@index([filialId])
  @@index([status])
}

model ContaRecebimento {
  id             String                @id @default(uuid())
  finalidade     FinalidadeRecebimento
  chavePix       String
  nomeFavorecido String
  nomeBanco      String?
  ativo          Boolean               @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, finalidade])
  @@index([empresaId])
}