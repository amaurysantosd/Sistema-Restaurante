// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Perfil {
  ADMIN
  GERENTE
  GARCOM
  CAIXA
  COZINHA
  BAR
}

model Empresa {
  id           String   @id @default(uuid())
  nomeFantasia String
  cnpj         String   @unique
  telefone     String
  email        String
  ativo        Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  filiais    Filial[]
  usuarios   Usuario[]
  categorias Categoria[]

  tipoAmbientes TipoAmbiente[]
}

model Filial {
  id        String   @id @default(uuid())
  nome      String
  cnpj      String?  @unique
  telefone  String?
  endereco  String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  usuarios Usuario[]

  @@index([empresaId])
  ambientes Ambiente[]
}

model Ambiente {
  id          String       @id @default(uuid())
  nome        String
  descricao   String?
  tipoAmbienteId String
  tipoAmbiente   TipoAmbiente @relation(fields: [tipoAmbienteId], references: [id])
  andar       Int?
  capacidade  Int?
  ativo       Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  filialId String
  filial   Filial @relation(fields: [filialId], references: [id])

  /* cria um índice na coluna filialId, o que acelera consultas do tipo "todos os ambientes desta 
  filial */
  @@index([filialId])

  // Lado inverso da relacao: um Ambiente pode ter varias Mesas
  mesas Mesa[]
}

model Mesa {
  id         String   @id @default(uuid())
  numero     String
  capacidade Int?
  qrCode     String   @unique
  ativo      Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  /* Relacionamento cria uma coluna 'ambienteId', ]
  Ela guarda o ID do ambiente ao qual a mesa pertence. */
  ambienteId String
  /* Relação - Essa linha diz ao Prisma: "O campo ambienteId referencia o id da 
  tabela Ambiente." */
  ambiente   Ambiente @relation(fields: [ambienteId], references: [id])

  // Cria um índice para a coluna ambienteId
  @@index([ambienteId])
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senha     String
  perfil    Perfil
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  filialId String?
  filial   Filial? @relation(fields: [filialId], references: [id])

  @@index([empresaId])
  @@index([filialId])
}

model Categoria {
  id        String   @id @default(uuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  @@unique([empresaId, nome])
  @@index([empresaId])
}

model TipoAmbiente {
  id        String   @id @default(uuid())
  nome      String
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  empresaId String
  empresa   Empresa @relation(fields: [empresaId], references: [id])

  ambientes Ambiente[]

  @@unique([empresaId, nome])
  @@index([empresaId])
}

